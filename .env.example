# ─── Database ──────────────────────────────────────────
POSTGRES_USER=songthanh
POSTGRES_PASSWORD=change_this_to_strong_password
POSTGRES_DB=song_thanh_cms
HOST_HTTP_PORT=80
PUBLIC_SITE_URL=https://songthanhelectric.com.vn

# ─── JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
SUPER_ADMIN_EMAIL=admin@songthanh.local
SUPER_ADMIN_PASSWORD=change_this_to_a_strong_admin_password
SUPER_ADMIN_NAME=Super Admin

# ─── API ──────────────────────────────────────────────
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CORS_ORIGINS=https://songthanh.com,https://www.songthanh.com

# Local binary storage. Leave unset in Docker to use the named api-storage volume.
# For local Windows development, prefer a path outside this source workspace.
# API_STORAGE_ROOT=D:\SongThanhRuntime\api-storage

# ─── Cloudflare R2 ────────────────────────────────────
# Keep `local` for offline development. Production should use `r2` and
# provide every R2 value below.
FILE_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=songthanh-media
