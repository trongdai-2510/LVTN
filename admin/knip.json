{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,template,default,route}.{ts,tsx}",
    "src/app/**/{middleware,instrumentation}.{ts,tsx}",
    "next.config.{js,ts}",
    "tailwind.config.{js,ts}",
    "postcss.config.{js,cjs,mjs}",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/types/**"
  ],
  "ignoreDependencies": [
    "@types/react",
    "@types/react-dom",
    "@types/node",
    "tailwindcss",
    "postcss",
    "autoprefixer",
    "eslint-config-next"
  ]
}
