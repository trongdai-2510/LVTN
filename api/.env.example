PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Leave empty for direct access. Behind a reverse proxy, list only its IP/CIDR.
# The proxy must replace incoming X-Forwarded-For rather than forwarding untrusted values.
TRUSTED_PROXY_CIDRS=

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=song_thanh_cms
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# Keep certificate verification enabled for remote databases.
# Only set false for a controlled environment with a documented exception.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional CA certificate for a private/self-managed PostgreSQL CA.
DATABASE_SSL_CA_PATH=

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

SUPER_ADMIN_EMAIL=admin@songthanh.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin

# Optional local binary storage root. Leave empty to use ./storage inside the API app.
# Use an absolute path outside the source workspace for large local product images.
# API_STORAGE_ROOT=D:\SongThanhRuntime\api-storage
# FILE_LIBRARY_STORAGE_ROOT=D:\SongThanhRuntime\api-storage\file-library
# IMPORT_WORKBOOK_STORAGE_ROOT=D:\SongThanhRuntime\api-storage\import-workbooks
